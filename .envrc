# Auto-loaded by direnv when entering ~/Desktop/Thesis-Code.
# Run once: direnv allow

export GIT_PAGER=cat
export PAGER=cat

set +u

source /opt/ros/jazzy/setup.bash

if [ -f ros2_ws/install/setup.bash ]; then
  source ros2_ws/install/setup.bash
fi

if [ -f thesis_env/bin/activate ]; then
  source thesis_env/bin/activate
fi

export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-42}"

set -u

# Project-local runtime/log hygiene.
export THESIS_ROOT="$PWD"
export COLCON_LOG_PATH="$THESIS_ROOT/ros2_ws/log/colcon"
export HAILORT_LOGGER_PATH="$THESIS_ROOT/ros2_ws/log/hailort"
mkdir -p "$COLCON_LOG_PATH" "$HAILORT_LOGGER_PATH"

# HailoRT may still emit hailort.log in the current working directory.
# Keep the repository root clean when entering the project.
rm -f "$THESIS_ROOT/hailort.log"

