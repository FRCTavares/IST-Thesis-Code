# Host-only recovery settings. No thesis runtime or UAV service is started.
THESIS_HOST_MODE=unattended
THESIS_HOST_INTERFACE=wlan0
THESIS_HOST_PIXHAWK_WIFI_CONNECTION="ISR Aero.Next GCS"

# Management-only profile for local SSH when Aero.Next GCS is the only
# reachable Wi-Fi. This profile does not grant Pixhawk/field authority.
THESIS_HOST_GCS_RESCUE_WIFI_CONNECTION="ISR Aero.Next GCS Rescue"
THESIS_HOST_GCS_RESCUE_AUTOCONNECT_PRIORITY=20
THESIS_HOST_GCS_SSH_SUBNET="192.168.8.0/24"

# Optional approved AERONEXT local-router field-authority fallback.
THESIS_HOST_PIXHAWK_WIFI_FALLBACK_CONNECTION=""
THESIS_HOST_PIXHAWK_ETHERNET_CONNECTION=pixhawk-apm
THESIS_HOST_STATE_DIR=/var/lib/thesis-host-health
# Three failed checks trigger a device reconnect. Six failed checks escalate
# to one bounded NetworkManager restart using an independent cooldown.
THESIS_HOST_FAILURE_THRESHOLD=3
THESIS_HOST_COOLDOWN_SECONDS=900
THESIS_HOST_MIN_FREE_GIB=20
